# Copy to catcam.env on the Pi, fill in, then: chmod 600 catcam.env
# catcam.env is git-ignored. Never commit real credentials.
# Note: systemd does not allow comments at the end of a value line.

MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# --- Optional (defaults shown) ---
# GPIO (BCM numbering) the PIR OUT pin is wired to
#PIR_GPIO=17
# Seconds with no motion that end a visit
#VISIT_TIMEOUT=30
# Seconds after boot to ignore the PIR while it settles
#WARMUP=60
# Seconds between snapshots during a visit; 0 = first snapshot only
#SNAPSHOT_INTERVAL=10
#SNAPSHOT_SIZE=1296x972
# Also keep JPEGs on the Pi (empty = don't), pruned to SNAPSHOT_KEEP files
#SNAPSHOT_DIR=/home/bill/catcam/snapshots
#SNAPSHOT_KEEP=500
# MQTT topic prefix and Home Assistant device ID
#DEVICE_ID=catcam
#DISCOVERY_PREFIX=homeassistant
